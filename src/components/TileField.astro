<canvas class="tilefield" aria-hidden="true" data-tilefield></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-tilefield]');
  const ctx = canvas?.getContext('2d');
  if (canvas && ctx) {
    const ramp = [
      [26, 12, 10],
      [143, 29, 18],
      [212, 80, 10],
      [248, 147, 0],
      [255, 226, 168]
    ];
    const heatRgb = (h: number) => {
      const x = Math.min(0.9999, Math.max(0, h)) * (ramp.length - 1);
      const i = Math.floor(x);
      const k = x - i;
      return ramp[i].map((v, j) => Math.round(v + (ramp[i + 1][j] - v) * k));
    };
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let tiles: { x: number; y: number; s: number; base: number; h: number; t: number }[] = [];
    let width = 0;
    let height = 0;
    let start = 0;

    const layout = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = canvas.clientWidth;
      height = canvas.clientHeight;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const s = width < 640 ? 16 : 22;
      const narrow = width < 640;
      const p0 = narrow ? { x: -0.2, y: 0.62 } : { x: 0.42, y: 1.08 };
      const p1 = narrow ? { x: 0.75, y: 0.66 } : { x: 0.86, y: 0.86 };
      const p2 = narrow ? { x: 1.08, y: 0.08 } : { x: 1.04, y: 0.1 };
      const curve = Array.from({ length: 200 }, (_, i) => {
        const t = i / 199;
        const u = 1 - t;
        return {
          t,
          x: (u * u * p0.x + 2 * u * t * p1.x + t * t * p2.x) * width,
          y: (u * u * p0.y + 2 * u * t * p1.y + t * t * p2.y) * height
        };
      });
      let seed = 11;
      const rand = () => {
        seed = (seed * 16807) % 2147483647;
        return (seed - 1) / 2147483646;
      };
      tiles = [];
      for (let y = 0; y < height + s; y += s) {
        for (let x = 0; x < width + s; x += s) {
          const cx = x + s / 2;
          const cy = y + s / 2;
          let best = { d: Infinity, t: 0 };
          for (const p of curve) {
            const d = (p.x - cx) ** 2 + (p.y - cy) ** 2;
            if (d < best.d) best = { d, t: p.t };
          }
          const reach = (narrow ? 12 : 18) + (narrow ? 80 : 170) * best.t ** 1.5;
          const h = Math.max(0, 1 - Math.sqrt(best.d) / reach) ** 1.4 * (0.35 + 0.65 * best.t);
          tiles.push({ x, y, s, base: 17 + Math.floor(rand() * 7), h, t: best.t });
        }
      }
    };

    const draw = (time: number) => {
      ctx.fillStyle = '#26282c';
      ctx.fillRect(0, 0, width, height);
      for (const tile of tiles) {
        const g = tile.base;
        let r = g;
        let gg = g + 1;
        let b = g + 3;
        if (tile.h > 0.02) {
          const e = reduce ? 0.62 : 0.5 + 0.5 * cycle(time - 0.4 - tile.t * 2.4);
          const k = tile.h * e;
          const [hr, hg, hb] = heatRgb(k);
          const a = Math.min(1, k * 1.6);
          r = Math.round(r + (hr - r) * a);
          gg = Math.round(gg + (hg - gg) * a);
          b = Math.round(b + (hb - b) * a);
        }
        ctx.fillStyle = `rgb(${r},${gg},${b})`;
        ctx.fillRect(tile.x + 0.5, tile.y + 0.5, tile.s - 1, tile.s - 1);
      }
    };

    const period = 7;
    const cycle = (time: number) => {
      if (time < 0) return 0;
      const p = (time % period) / period;
      return p < 0.07 ? 1 - Math.pow(1 - p / 0.07, 3) : Math.exp(-(p - 0.07) * 7);
    };

    let raf = 0;
    let onScreen = true;
    let lastDraw = 0;
    const frame = (now: number) => {
      if (now - lastDraw > 32) {
        lastDraw = now;
        draw((now - start) / 1000);
      }
      raf = requestAnimationFrame(frame);
    };
    const play = () => {
      cancelAnimationFrame(raf);
      if (!reduce && onScreen && !document.hidden) raf = requestAnimationFrame(frame);
    };

    const run = () => {
      layout();
      start = performance.now();
      if (reduce) draw(99);
      else play();
    };
    new IntersectionObserver(([e]) => {
      onScreen = e.isIntersecting;
      play();
    }).observe(canvas);
    document.addEventListener('visibilitychange', play);
    window.addEventListener('pageshow', (e) => {
      if (e.persisted) play();
    });

    let resizeTimer = 0;
    let lastWidth = 0;
    new ResizeObserver(() => {
      if (Math.abs(canvas.clientWidth - lastWidth) < 2) return;
      lastWidth = canvas.clientWidth;
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        layout();
        draw((performance.now() - start) / 1000);
      }, 120);
    }).observe(canvas);
    lastWidth = canvas.clientWidth;
    run();
  }
</script>

<style>
  .tilefield {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: #141518;
  }
</style>
