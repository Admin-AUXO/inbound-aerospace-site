---
import { founders, advisors } from '../data/site';
import Backers from './Backers.astro';
---
<ol class="roster">
  {founders.map((f) => (
    <li>
      <p class="roster__name">{f.name}</p>
      <div class="roster__body">
        <p class="roster__role meta">{f.role}</p>
        <p class="roster__text">{f.text}</p>
      </div>
    </li>
  ))}
</ol>

<div class="group">
  <h3>Advisors</h3>
  <ul class="panel">
    {advisors.map((a) => (
      <li>
        <p class="panel__name">{a.name}</p>
        <p class="panel__role">{a.role}</p>
      </li>
    ))}
  </ul>
</div>

<div class="group">
  <h3>Backed by</h3>
  <div class="backing">
    <Backers />
  </div>
</div>

<style>
  .roster,
  .panel {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--on-dark);
  }

  .roster li,
  .panel li {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    border-bottom: 1px solid var(--rule-dark);
  }

  .roster li {
    padding-block: clamp(1.75rem, 3vw, 2.5rem);
    align-items: start;
  }

  .roster__name {
    font-family: var(--display);
    font-stretch: 108%;
    font-size: clamp(2rem, 4.4vw, 3.75rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--on-dark);
    text-wrap: balance;
  }

  .roster__role {
    color: var(--heat-3);
    margin-top: 0.35rem;
  }

  .roster__text {
    margin-top: 0.9rem;
    max-width: 40ch;
    color: var(--on-dark-soft);
  }

  .group {
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .group h3 {
    margin-bottom: 1.25rem;
    font-size: clamp(1.4rem, 2.2vw, 1.75rem);
    font-weight: 450;
    color: var(--on-dark);
  }

  .panel li {
    padding-block: 1.1rem;
    align-items: baseline;
  }

  .panel__name {
    font-family: var(--display);
    font-stretch: 108%;
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    letter-spacing: -0.015em;
    color: var(--on-dark);
  }

  .panel__role {
    color: var(--on-dark-soft);
    font-size: 0.9375rem;
  }

  .backing {
    padding-top: 1.75rem;
    border-top: 1px solid var(--on-dark);
  }

  @media (max-width: 48rem) {
    .roster li,
    .panel li {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .panel li {
      gap: 0.25rem;
    }
  }
</style>
