---
const W = 1200;
const H = 440;
const m = { l: 48, r: 16, t: 36, b: 56 };
const tMax = 20;
const gMax = 6;
const x = (t: number) => m.l + (t / tMax) * (W - m.l - m.r);
const y = (g: number) => H - m.b - (g / gMax) * (H - m.t - m.b);

const path = (fn: (t: number) => number) =>
  Array.from({ length: 161 }, (_, i) => (i / 160) * tMax)
    .map((t, i) => `${i ? 'L' : 'M'}${x(t).toFixed(1)},${y(fn(t)).toFixed(1)}`)
    .join(' ');

const capsule = (t: number) => 5.5 * Math.exp(-(((t - 6) / 1.6) ** 2));
const lifting = (t: number) => 2 / (1 + Math.exp(-(t - 5.5) * 1.4)) - 2 / (1 + Math.exp(-(t - 16) * 1.1));

const capsulePath = path(capsule);
const liftingPath = path(lifting);
const gTicks = [0, 2, 4, 6];
const area = (d: string) => `${d} L${x(tMax)},${y(0)} L${x(0)},${y(0)} Z`;
const peak = { x: x(6), y: y(5.5) };
const tTicks = [0, 5, 10, 15, 20];
---
<figure class="chart" data-load-chart>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="chart-title chart-desc">
    <title id="chart-title">Re-entry load over time, capsule against lifting body</title>
    <desc id="chart-desc">An illustrative ballistic capsule profile peaks above 5 g. Inbound's lifting body stays at or below 2 g for a longer, gentler descent.</desc>
    <defs>
      <clipPath id="over">
        <rect x={m.l} y={m.t} width={W - m.l - m.r} height={y(2) - m.t} />
      </clipPath>
      <clipPath id="under">
        <rect x={m.l} y={y(2)} width={W - m.l - m.r} height={H - m.b - y(2)} />
      </clipPath>
      <clipPath id="reveal">
        <rect x="0" y="0" width={W} height={H} data-reveal />
      </clipPath>
    </defs>
    {gTicks.map((g) => (
      <g data-stage="grid">
        <line x1={m.l} x2={W - m.r} y1={y(g)} y2={y(g)} class:list={['grid', { 'grid--limit': g === 2 }]} />
        <text x={m.l - 12} y={y(g) + 4} text-anchor="end" class="tick">{g}</text>
      </g>
    ))}
    {tTicks.map((t) => (
      <text x={x(t)} y={H - m.b + 24} text-anchor="middle" class="tick" data-stage="grid">{t}</text>
    ))}
    <text x={m.l - 12} y={m.t - 18} text-anchor="end" class="axis" data-stage="grid">g</text>
    <text x={W - m.r} y={y(2) - 8} text-anchor="end" class="axis axis--limit" data-stage="grid">2 g</text>
    <text x={W - m.r} y={H - 8} text-anchor="end" class="axis" data-stage="grid">Minutes from entry interface</text>
    <g clip-path="url(#reveal)">
    <path d={area(liftingPath)} class="fill fill--inbound" />
    <path d={area(capsulePath)} class="fill fill--over" clip-path="url(#over)" />
    <path d={capsulePath} class="line line--capsule" clip-path="url(#under)" />
    <path d={capsulePath} class="line line--over" clip-path="url(#over)" />
    <path d={liftingPath} class="line line--inbound" />
    <circle cx={peak.x} cy={peak.y} r="4" class="peak" />
    <line x1={peak.x + 8} x2={peak.x + 56} y1={peak.y} y2={peak.y} class="leader" />
    </g>
    <text x={peak.x + 64} y={peak.y + 5} class="label label--heat" data-stage="label">Capsule, 5 g and above</text>
    <text x={x(10.5)} y={y(2) - 18} class="label" data-stage="label">Inbound, up to 2 g</text>
  </svg>
  <figcaption data-stage="label">Illustrative profiles, not flight data. Peak loads as published by Inbound.</figcaption>
</figure>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const root = document.querySelector<HTMLElement>('[data-load-chart]');
  const rect = root?.querySelector<SVGRectElement>('[data-reveal]');
  if (root && rect && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    gsap.registerPlugin(ScrollTrigger);
    const full = Number(rect.getAttribute('width'));
    gsap.fromTo(rect, { attr: { width: 0 } }, { attr: { width: full }, duration: 2.2, ease: 'power1.inOut', scrollTrigger: { trigger: root, start: 'top 70%', once: true } });
  }
</script>

<style>
  .chart {
    margin: 0;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .grid {
    stroke: var(--rule-light);
    stroke-width: 1;
  }

  .grid--limit {
    stroke: var(--ink-soft);
    stroke-dasharray: 2 6;
  }

  .fill--inbound {
    fill: rgb(20 21 24 / 0.06);
  }

  .fill--over {
    fill: rgb(212 80 10 / 0.12);
  }

  .peak {
    fill: var(--heat-2);
  }

  .leader {
    stroke: var(--heat-2);
    stroke-width: 1;
  }

  .axis--limit {
    fill: var(--ink-soft);
  }

  .tick,
  .axis {
    font: 500 16px var(--display);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    fill: var(--ink-soft);
  }

  .label {
    font: 500 19px var(--display);
    letter-spacing: 0.01em;
    fill: var(--ink);
  }

  .label--heat {
    fill: #b33c08;
  }

  .line {
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .line--capsule {
    stroke: #9d998f;
  }

  .line--over {
    stroke: var(--heat-2);
  }

  .line--inbound {
    stroke: var(--ink);
    stroke-width: 2.5;
  }

  @media (max-width: 40rem) {
    .chart {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    svg {
      min-width: 680px;
    }
  }

  figcaption {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: var(--ink-soft);
  }
</style>
