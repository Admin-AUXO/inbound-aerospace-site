---
import HeroShell from './HeroShell.astro';

interface Props {
  title: string;
  lede: string;
}

const { title, lede } = Astro.props;
const starts = [34, 112, 200, 288, 366];
const cx = 200;
const cy = 292;
const paths = starts.map((x) => `M${x} 0 C${x} 130, ${cx + (x - cx) * 0.3} 150, ${cx} ${cy - 14}`);
---
<HeroShell title={title} lede={lede}>
  <slot />
  <svg slot="aside" class="descent" viewBox="0 0 400 320" role="presentation" aria-hidden="true">
    {paths.map((d, i) => (
      <path d={d} pathLength="1" style={`--i:${i}`} />
    ))}
    <circle class="ring ring--outer" cx={cx} cy={cy} r="14" />
    <circle class="ring ring--inner" cx={cx} cy={cy} r="5" />
  </svg>
</HeroShell>

<style>
  .descent {
    width: 100%;
    max-width: 26rem;
    height: auto;
    margin-inline-start: auto;
    overflow: visible;
  }

  path {
    fill: none;
    stroke: var(--on-dark);
    stroke-opacity: 0.34;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 2.2s calc(var(--i) * 0.12s + 0.15s) var(--ease) forwards;
  }

  .ring {
    fill: none;
    stroke: var(--heat-3);
    stroke-width: 1.25;
    vector-effect: non-scaling-stroke;
    opacity: 0;
    animation: appear 0.8s 1.8s var(--ease) forwards;
  }

  .ring--inner {
    fill: var(--heat-3);
    stroke: none;
  }

  @keyframes draw {
    to { stroke-dashoffset: 0; }
  }

  @keyframes appear {
    to { opacity: 1; }
  }

  @media (max-width: 56rem) {
    .descent {
      max-width: 20rem;
      margin-inline: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    path { animation: none; stroke-dashoffset: 0; }
    .ring { animation: none; opacity: 1; }
  }
</style>
