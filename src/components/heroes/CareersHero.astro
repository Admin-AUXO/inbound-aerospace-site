---
import HeroShell from './HeroShell.astro';
import { roles, careersForm } from '../../data/pages';

interface Props {
  title: string;
  lede: string;
}

const { title, lede } = Astro.props;
const role = roles[0];
---
<HeroShell title={title} lede={lede}>
  <slot />
  <article slot="aside" class="role-card">
      <p class="role-card__meta">Open role</p>
      <h2>{role.title}</h2>
      <dl>
        <div><dt>Team</dt><dd>{role.team}</dd></div>
        <div><dt>Type</dt><dd>{role.type}</dd></div>
        <div><dt>Location</dt><dd>{role.location}</dd></div>
      </dl>
      <a class="btn btn--heat" href={careersForm} target="_blank" rel="noopener">Apply for this role</a>
  </article>
</HeroShell>

<style>
  .role-card {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
    padding-top: 1.25rem;
    border-top: 1px solid var(--heat-3);
    animation: rise 1s var(--ease) both;
  }

  .role-card__meta {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  h2 {
    font-size: clamp(1.6rem, 2.8vw, 2.4rem);
    font-weight: 450;
  }

  dl {
    margin: 0;
    width: 100%;
    display: grid;
  }

  dl div {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.55rem;
    border-bottom: 1px solid var(--rule-dark);
  }

  dt {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-dim);
    align-self: center;
  }

  dd {
    margin: 0;
    color: var(--on-dark);
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(0.6rem); }
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .role-card { animation: none; }
  }
</style>
