---
import { pages } from '../data/pages';
import { url } from '../lib/url';

const chapters = [
  { page: pages.spacecraft, hook: 'A wingless body that flies home instead of falling.', text: 'How a lifting body is designed to keep re-entry at or below 2 g, and the five phases from integration to touchdown.' },
  { page: pages.payloads, hook: 'Experiments that behave differently without gravity.', text: 'What flies, the published payload brief, and how an experiment reaches orbit and comes back.' },
  { page: pages.science, hook: 'In orbit, a flame burns as a sphere.', text: 'What microgravity is, why it changes how things form, and why the timing matters as the ISS retires.' },
  { page: pages.pads, hook: 'The landing system also works on its own.', text: 'Inbound PADS, a steerable parachute system for precise delivery in defence and emergency supply.' }
];
---
<ol class="chapters">
  {chapters.map((c) => (
    <li>
      <a href={url(c.page.path)} class="chapter">
        <span class="chapter__label meta">{c.page.label}</span>
        <span class="chapter__hook">{c.hook}</span>
        <span class="chapter__text">{c.text}</span>
        <span class="chapter__go" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
        </span>
      </a>
    </li>
  ))}
</ol>

<style>
  .chapters {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--on-dark);
  }

  .chapter {
    position: relative;
    display: grid;
    grid-template-columns: minmax(7rem, 1fr) minmax(0, 5fr) minmax(0, 3fr) 2.5rem;
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: baseline;
    padding-block: clamp(1.5rem, 3vw, 2.25rem);
    border-bottom: 1px solid var(--rule-dark);
    text-decoration: none;
    color: var(--on-dark);
  }

  .chapter::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--heat-3);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease);
  }

  .chapter:hover::after,
  .chapter:focus-visible::after {
    transform: scaleX(1);
  }

  .chapter__label {
    color: var(--ink-dim);
    transition: color 0.3s var(--ease);
  }

  .chapter__hook {
    font-family: var(--display);
    font-size: clamp(1.5rem, 2.8vw, 2.4rem);
    font-weight: 420;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .chapter__text {
    font-size: 0.9375rem;
    color: var(--on-dark-soft);
  }

  .chapter__go {
    align-self: center;
    justify-self: end;
    color: var(--ink-dim);
    transition: color 0.3s var(--ease), transform 0.4s var(--ease);
  }

  .chapter:hover .chapter__label,
  .chapter:hover .chapter__go {
    color: var(--heat-3);
  }

  .chapter:hover .chapter__go {
    transform: translateX(4px);
  }

  @media (max-width: 60rem) {
    .chapter {
      grid-template-columns: 1fr 2rem;
      gap: 0.6rem 1rem;
    }

    .chapter__label,
    .chapter__hook,
    .chapter__text {
      grid-column: 1;
    }

    .chapter__go {
      grid-column: 2;
      grid-row: 1 / span 3;
    }
  }
</style>
