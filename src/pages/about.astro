---
import Base from '../layouts/Base.astro';
import PageHero from '../components/heroes/AboutHero.astro';
import NextChapter from '../components/NextChapter.astro';
import Team from '../components/Team.astro';
import { pages, about } from '../data/pages';
import { founders } from '../data/site';
import { abs } from '../lib/url';

const page = pages.about;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    url: abs(page.path),
    about: { '@id': abs('/#organization') },
    mainEntity: founders.map((f) => ({ '@type': 'Person', name: f.name, jobTitle: f.role, worksFor: { '@id': abs('/#organization') } }))
  }
];
const missionS = about.mission.split(/(?<=\.)\s+/);
---
<Base page={page} schema={schema} markdown="/about.md">
  <PageHero title="Built in Chennai, incubated at IIT Madras" lede={about.lede} />

  <section class="zone zone--light" aria-labelledby="mission-title">
    <div class="wrap mission">
      <h2 id="mission-title" class="lead__title">Mission</h2>
      <p class="mission__statement">{missionS[0]}</p>
      <p class="mission__after">{missionS.slice(1).join(" ")}</p>
      <dl class="mission__facts">
        <div>
          <dt>Origin</dt>
          <dd>{about.origin}</dd>
        </div>
        <div>
          <dt>Incubation</dt>
          <dd>{about.incubation}</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="zone zone--dark" aria-labelledby="people-title">
    <div class="wrap">
      <div class="lead">
        <h2 id="people-title" class="lead__title">Founders</h2>
        <p class="lead__text">An aerospace engineer, an operations lead and a naval test pilot, advised by former senior ISRO leaders.</p>
      </div>
      <Team />
    </div>
  </section>
  <NextChapter page={pages.news} line="Funding, test milestones and events so far." />
</Base>

<style>
  .mission {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    column-gap: clamp(2.5rem, 6vw, 5rem);
    row-gap: var(--space-block);
  }

  .mission h2 {
    grid-row: 1;
  }

  .mission__statement {
    grid-column: 1 / -1;
    grid-row: 2;
    max-width: 30ch;
    font-family: var(--display);
    font-size: clamp(1.9rem, 4vw, 3.4rem);
    font-weight: 400;
    font-stretch: 106%;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .mission__after {
    grid-column: 2;
    grid-row: 3;
    max-width: 44ch;
    font-size: 1.125rem;
    color: var(--ink-soft);
  }

  .mission__facts {
    grid-column: 1 / -1;
    grid-row: 4;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    column-gap: clamp(2.5rem, 6vw, 5rem);
    margin: 0;
    padding-top: 0;
    border-top: 1px solid var(--ink);
  }

  .mission__facts div {
    position: relative;
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding-top: 1.75rem;
  }

  .mission__facts div::before {
    content: '';
    position: absolute;
    top: -5px;
    left: 0;
    width: 9px;
    height: 9px;
    background: var(--heat-3);
  }

  .mission__facts dt {
    font-family: var(--display);
    font-size: clamp(1.4rem, 2.2vw, 1.9rem);
    font-weight: 450;
    font-stretch: 106%;
    letter-spacing: -0.02em;
  }

  .mission__facts dd {
    margin: 0;
    max-width: 44ch;
    color: var(--ink-soft);
  }

  @media (max-width: 60rem) {
    .mission,
    .mission__facts {
      grid-template-columns: 1fr;
    }

    .mission__after,
    .mission__statement,
    .mission__facts {
      grid-column: 1;
      grid-row: auto;
    }

    .mission__facts div + div {
      margin-top: 2rem;
    }
  }
</style>
