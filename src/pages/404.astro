---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---
<Base page={{ path: '/404/', label: 'Not found', title: 'Page not found | Inbound Aerospace', description: 'This page does not exist.', noindex: true }}>
  <section class="zone zone--dark lost">
    <div class="wrap">
      <h1>Page not found</h1>
      <p>The page you are looking for does not exist or has moved.</p>
      <a class="btn btn--heat" href={url('/')}>Return to the home page</a>
    </div>
  </section>
</Base>

<style>
  .lost {
    min-height: 80svh;
    display: grid;
    align-items: center;
    padding-top: 8rem;
  }

  .lost .wrap {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  h1 {
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    font-weight: 430;
    font-stretch: 110%;
    letter-spacing: -0.035em;
  }

  p {
    color: var(--on-dark-soft);
    font-size: 1.1875rem;
  }
</style>
